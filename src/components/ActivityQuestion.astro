  <header class="mb-2">
    <span class="text-xs font-bold tracking-widest uppercase text-violet-400 dark:text-violet-500 leading-none">
      Think About It
    </span>
  </header>
  <div class="text-base leading-relaxed text-gray-600 dark:text-gray-300 [&>p]:my-2 [&>p:first-child]:mt-0 [&>p:last-child]:mb-0">
    <slot />
  </div>
</aside>

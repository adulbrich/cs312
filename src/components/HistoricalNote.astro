---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<aside class="not-content border-l-[3px] border-gray-300 dark:border-gray-700 bg-gray-100 dark:bg-gray-800 rounded-r-sm px-4 py-3.5 my-6">
  <header class="flex flex-col gap-0.5 mb-2.5">
    <span class="text-xs font-bold tracking-widest uppercase text-gray-400 dark:text-gray-400 leading-none">
      Historical Note
    </span>
    <span class="text-base font-semibold text-gray-700 dark:text-gray-300 leading-snug">
      {title}
    </span>
  </header>
  <div class="text-base leading-relaxed text-gray-500 dark:text-gray-300 [&>p]:my-2 [&>p:first-child]:mt-0 [&>p:last-child]:mb-0">
    <slot />
  </div>
</aside>

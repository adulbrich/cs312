---
import katex from "katex";

const { formula = "", inline = true } = Astro.props;
const html = katex.renderToString(formula, { throwOnError: false, displayMode: !inline });
---

<span class={inline ? "inline" : "block text-center"} set:html={html}/>

<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/katex@0.18.4/dist/katex.min.css"
  integrity="sha384-u1zONI5gPXUx0UKI62c75/zww972y0v2rSK5ZYlVdS6xEuWDeZWUI66v6t1gvlXJ"
  crossorigin="anonymous"
/>